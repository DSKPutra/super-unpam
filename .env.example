# Salin ke .env.local untuk pengembangan; di Vercel isi lewat Project Settings → Environment Variables.

# Klien: false = pakai BFF /api; tidak di-set/true = data contoh (mode demo)
VITE_USE_DEMO=true

# Server (BFF). Buat dengan: openssl rand -hex 32
SESSION_SECRET=
QR_SECRET=

# mock | http (bawaan mock). Per sistem: CONNECTOR_SSO, CONNECTOR_MY_UNPAM, CONNECTOR_MENTARI, ...
CONNECTOR_MODE=mock

# Koordinat resmi area presensi, JSON: [{"name":"...","lat":-6.0,"lng":106.0,"radius":300}]
CAMPUS_GEOFENCES=
